{
  "package_format": "tin-workflow-package-v1",
  "definition": {
    "key": "growth.competitor_watch",
    "title": "Watch competitor moves",
    "description": "Check a small set of public competitor sources for meaningful product, pricing, positioning, and launch changes, then turn verified changes into a short marketing action brief.",
    "version": "1.0.0",
    "executor": "codex.procedure",
    "schedule_modes": [
      "on_demand",
      "weekly"
    ],
    "input_schema": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "project_id",
        "competitor_urls"
      ],
      "properties": {
        "project_id": {
          "type": "string",
          "format": "uuid"
        },
        "competitor_urls": {
          "type": "string",
          "minLength": 1,
          "maxLength": 3000,
          "title": "Competitor sources",
          "description": "One public HTTPS URL per line. Prefer pricing, product, changelog, release-notes, or homepage URLs. Maximum three competitors.",
          "x-tin-ui": {
            "control": "textarea",
            "order": 10
          }
        },
        "focus": {
          "type": "string",
          "maxLength": 1000,
          "default": "",
          "title": "What should matter most?",
          "description": "Optional focus such as pricing, AI features, integrations, or positioning.",
          "x-tin-ui": {
            "control": "textarea",
            "order": 20
          }
        }
      }
    },
    "procedure": {
      "prompt_path": "PROMPT.md",
      "skills_path": "skills",
      "skill_files": [
        "skills/competitor-watch/SKILL.md"
      ],
      "entry_skill": "competitor-watch",
      "workspace": {
        "kind": "project.state"
      },
      "sandbox": {
        "profile": "isolated",
        "egress": "fenced",
        "timeout_seconds": 900
      },
      "output": {
        "kind": "project.artifact",
        "path": "reports/COMPETITOR_WATCH.md",
        "media_type": "text/markdown",
        "max_bytes": 30000
      }
    }
  }
}

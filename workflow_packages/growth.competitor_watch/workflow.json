{
  "package_format": "tin-workflow-package-v1",
  "definition": {
    "key": "growth.competitor_watch",
    "title": "Watch competitor moves",
    "description": "Detect and classify meaningful public changes on competitor pages, verify evidence, explain marketing implications, and produce concrete marketing actions.",
    "version": "1.0.0",
    "executor": "codex.procedure",
    "schedule_modes": ["on_demand"],
    "input_schema": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "project_id": { "type": "string", "format": "uuid" },
        "targets": { "type": "array", "title": "Public pages to watch", "items": { "type": "string", "format": "uri", "minLength": 10, "maxLength": 2000 }, "minItems": 1, "maxItems": 40 },
        "watch_types": { "type": "array", "items": { "type": "string", "enum": ["pricing","features","docs","changelog","blog","product_page","terms","other"] }, "default": ["pricing","features","product_page","changelog"], "title": "Change types to watch" },
        "since": { "type": "string", "format": "date-time", "title": "Compare changes since" },
        "notify_threshold": { "type": "integer", "minimum": 1, "maximum": 100, "default": 10, "title": "Maximum number of changes to report" }
      },
      "required": ["project_id", "targets"]
    },
    "procedure": {
      "prompt_path": "PROMPT.md",
      "skills_path": "skills",
      "skill_files": ["skills/competitor-watch/SKILL.md"],
      "entry_skill": "competitor-watch",
      "workspace": { "kind": "project.state" },
      "sandbox": { "profile": "isolated", "egress": "fenced", "timeout_seconds": 900 },
      "output": {
        "kind": "project.artifact",
        "path_template": "reports/monitoring/competitor_moves/{run_id}.md",
        "media_type": "text/markdown",
        "max_bytes": 200000
      }
    }
  }
}
